   findVideoToPiP(doc) {
     let video = doc.activeElement;
     if (!HTMLVideoElement.isInstance(video)) {
+      // For Google Meet (meet.google.com), participant streams and screen shares
+      // are WebRTC MediaStreams with NaN duration. Pick the largest active visible
+      // video element (e.g. presentation screen-share or main active speaker)
+      // rather than a small self-view thumbnail.
+      const isGoogleMeet = doc?.location?.hostname?.endsWith("meet.google.com");
+      if (isGoogleMeet) {
+        let meetVideos = [...doc.querySelectorAll("video")].filter(
+          v => !v.paused && v.clientWidth >= 100 && v.clientHeight >= 100
+        );
+        if (meetVideos.length) {
+          meetVideos.sort(
+            (a, b) => b.clientWidth * b.clientHeight - a.clientWidth * a.clientHeight
+          );
+          return meetVideos[0];
+        }
+      }
+
       let listOfVideos = [...doc.querySelectorAll("video")].filter(
         v => !isNaN(v.duration)
       );
