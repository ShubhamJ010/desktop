+  box-shadow: inset 0 0 0 0.5px
+    light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.15));
+  opacity: 0;
+  pointer-events: none;
+  will-change: transform, opacity;
+  transition: transform 90ms cubic-bezier(0.2, 0, 0, 1),
+    opacity 120ms cubic-bezier(0.2, 0, 0, 1);
+}
+
+.ctrlTab-pill.is-visible {
+  opacity: 1;
+}
