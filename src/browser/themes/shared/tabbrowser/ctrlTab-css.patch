+  height: calc(var(--ctrl-tab-rows, 0) * 40px);
+  max-height: 360px;
+  overflow: hidden;
+  transition: height 120ms cubic-bezier(0.2, 0, 0, 1),
+              opacity 120ms cubic-bezier(0.2, 0, 0, 1);
