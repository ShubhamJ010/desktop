+  user-select: none;
 }
 
-.ctrlTab-preview > .button-box {
-  display: none;
+/* Focused/hovered row. Ardia fills the row and adds the same 0.5px ring:
+ *   backgroundColor: focused ? switcherFocus : undefined
+ *   borderWidth: focused ? hairline.ring : 0
+ *   borderColor: switcherOutline
+ * Hover is routed through the controller, so :hover needs no rule of its own
+ * (the pointer only selects once it has really moved). */
+.ctrlTab-preview[selected="true"],
+.ctrlTab-preview:focus {
+  background-color: light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.18));
+  border-color: light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.15));
 }
 
