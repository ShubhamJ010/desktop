-/* Ctrl-Tab */
+/*
+ * Zen / Ardia "Recent Tabs" switcher
+ *
+ * 1:1 port of Ardia's floating tab switcher:
+ *   apps/browser/src/components/sidebar/TabSwitcher.tsx
+ *   apps/browser/src/components/sidebar/SectionLabel.tsx
+ *   apps/browser/src/components/favicon/Favicon.tsx
