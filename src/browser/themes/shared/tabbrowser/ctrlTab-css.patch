+  margin: 0 !important;
+  overflow: visible !important;
+  max-width: none !important;
+  max-height: none !important;
+}
+
+/* Card, using the shared Ardia glass recipe (zen-ardia-glass.css). */
+.ctrlTab-card {
+  display: flex;
+  flex-direction: column;
+  box-sizing: border-box;
+  flex: none;
+
+  /* WIDTH */
+  width: 400px;
+
+  /* SWITCHER_PAD, space.m */
+  padding: 8px;
+
+  /* SWITCHER_RADIUS, radius.sheet */
+  border-radius: 16px;
+
+  /* Denser than the shared glass fill: a popup window has no page behind it to
+   * sample. */
+  --zen-ardia-glass-fill: light-dark(
+    rgba(248, 248, 252, 0.97),
+    rgba(40, 41, 45, 0.97)
+  );
+
+  --ctrl-tab-text-primary: light-dark(#111111, #ffffff);
+
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui,
+    sans-serif;
+  -moz-osx-font-smoothing: grayscale;
+
+  user-select: none;
+  animation: ctrlTab-card-in 150ms cubic-bezier(0.2, 0, 0, 1);
+  transition: opacity 120ms cubic-bezier(0.2, 0, 0, 1),
+              transform 120ms cubic-bezier(0.2, 0, 0, 1);
+}
+
+.ctrlTab-card.closing {
+  opacity: 0 !important;
+  transform: scale(0.96) translateY(4px) !important;
+  pointer-events: none !important;
+}
+
+#ctrlTab-panel .ctrlTab-card.zen-ardia-glass {
+  background-color: var(--zen-ardia-glass-fill, light-dark(#ffffff, #2a2a2a));
+  backdrop-filter: var(
+    --zen-ardia-glass-filter,
+    blur(42px) saturate(180%)
+  ) !important;
+  -webkit-backdrop-filter: var(
+    --zen-ardia-glass-filter,
+    blur(42px) saturate(180%)
+  ) !important;
+
+  border: 0.5px solid
+    light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.1));
+  box-shadow: 0 12px 28px
+    light-dark(rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.5));
+}
+
+@keyframes ctrlTab-card-in {
+  from {
+    opacity: 0;
+    transform: scale(0.96) translateY(-4px);
+  }
+  to {
+    opacity: 1;
+    transform: scale(1) translateY(0);
   }
