-  border: none;
+
+  /* Reserve the focused ring so selecting a row never shifts its contents. */
+  border: 0.5px solid transparent;
+  outline: none !important;
+
   background-color: transparent;
+  display: flex;
+  flex-direction: row;
+  align-items: center;
+  gap: 10px;
