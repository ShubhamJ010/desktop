+
+/* Last resort: the space has tabs, but the filters hid them all. */
+.ctrlTab-card.is-fallback .ctrlTab-list {
+  opacity: 0.65;
+}
+
+/* The list moves as one, in the switch direction. Staggered rows flicker on
+ * long lists. */
+@keyframes ctrlTabSwapInNext {
+  from {
+    opacity: 0.45;
+    transform: translateY(6px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+@keyframes ctrlTabSwapInPrev {
+  from {
+    opacity: 0.45;
+    transform: translateY(-6px);
+  }
+  to {
+    opacity: 1;
+    transform: translateY(0);
+  }
+}
+
+.ctrlTab-list.swap-in-next {
+  animation: ctrlTabSwapInNext 130ms cubic-bezier(0.2, 0, 0, 1);
+}
+
+.ctrlTab-list.swap-in-prev {
+  animation: ctrlTabSwapInPrev 130ms cubic-bezier(0.2, 0, 0, 1);
+}
+
+/* Selection pill. Moving it is a transform, so rows never repaint. */
+.ctrlTab-pill {
+  position: absolute;
+  inset-inline: 0;
+  top: 0;
+  height: 40px;
+  border-radius: 8px;
