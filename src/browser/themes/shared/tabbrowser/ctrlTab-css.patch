+              max-height 120ms cubic-bezier(0.2, 0, 0, 1),
+              height 120ms cubic-bezier(0.2, 0, 0, 1),
+              padding-top 120ms cubic-bezier(0.2, 0, 0, 1),
+              padding-bottom 120ms cubic-bezier(0.2, 0, 0, 1),
+              margin 120ms cubic-bezier(0.2, 0, 0, 1);
