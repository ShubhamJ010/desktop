+ * Layout constants (kept in sync with browser-ctrlTab.js):
+ *   WIDTH           400  (TabSwitcher WIDTH)
+ *   ROW              40  (TabSwitcher ROW)
+ *   SWITCHER_RADIUS  16  (radius.sheet)
+ *   SWITCHER_PAD      8  (space.m)
+ *   ROW_RADIUS        8  (concentric(SWITCHER_RADIUS, SWITCHER_PAD))
+ *   MAX_ROWS          9  (TabSwitcher MAX_ROWS)
+ *
+ * Colours are taken from Ardia's design tokens; the panel fill is densified
+ * because a chrome popup cannot sample the page behind it:
+ *   panel          dark rgba(40,41,45,0.97) / light rgba(248,248,252,0.97)
+ *   panelBorder    rgba(255,255,255,0.1) dark / rgba(0,0,0,0.1) light
+ *   textPrimary    #FFFFFF dark / #000000 light
+ *   textSecondary  rgba(255,255,255,0.5) dark / rgba(0,0,0,0.5) light
+ *   switcherFocus  rgba(255,255,255,0.18) dark / rgba(0,0,0,0.10) light
+ *   switcherOutline rgba(255,255,255,0.15) dark / rgba(0,0,0,0.1) light
+ */
 
+/* -------------------------------------------------------------------------
+ * Popup panel reset
+ *
+ * #ctrlTab-panel is a native <panel>. Strip its arrow/menupopup chrome so the
+ * only thing visible is our card. The extra padding is the room reserved for
+ * the card's drop shadow, since a popup window clips anything outside its own
+ * bounds (browser-ctrlTab.js subtracts this margin when positioning).
+ * ---------------------------------------------------------------------- */
 #ctrlTab-panel {
+  --ctrl-tab-shadow-margin: 24px;
+
   appearance: none;
-  --panel-background-color: hsla(0, 0%, 40%, 0.85);
-  --panel-text-color: white;
+  background-color: transparent !important;
+  border: none !important;
+  box-shadow: none !important;
+  --panel-background-color: transparent;
   --panel-border-color: transparent;
-  --panel-padding: 20px 10px 10px;
+  --panel-padding: 0;
+  --panel-shadow-margin: 0;
   -moz-window-shadow: none;
-  background-color: transparent;
-  @media not (-moz-platform: macos) {
-    font-weight: var(--font-weight-bold);
+  padding: var(--ctrl-tab-shadow-margin) !important;
+  overflow: visible !important;
+}
+
+#ctrlTab-panel::part(content),
+#ctrlTab-panel > .panel-arrowcontainer,
+#ctrlTab-panel > .panel-arrowcontent {
+  background: transparent !important;
+  border: none !important;
+  box-shadow: none !important;
+  padding: 0 !important;
+
+  /* popup.css gives ::part(content) `overflow: clip`, a positive
+   * --panel-box-shadow-margin and a max-width clamp. Those exist to keep menu
+   * content inside the native rounded background, but here they clip the
+   * card's right edge (killing its rounded corner and drop shadow). The card
+   * owns all of that, so let the layout box be a plain, unclipped container. */
+  margin: 0 !important;
+  overflow: visible !important;
+  max-width: none !important;
+  max-height: none !important;
+}
+
+/* -------------------------------------------------------------------------
+ * Floating card
+ *
+ * Ardia renders this through <Panel> with the system popover material. Zen's
+ * shared Ardia glass recipe (zen-ardia-glass.css) is the same material used by
+ * the swipe capsule and PiP controls, so the switcher reads as part of the
+ * browser instead of as a bolted-on overlay.
+ * ---------------------------------------------------------------------- */
+.ctrlTab-card {
+  display: flex;
+  flex-direction: column;
+  box-sizing: border-box;
+  flex: none;
+
+  /* TabSwitcher WIDTH */
+  width: 400px;
+
+  /* SWITCHER_PAD = space.m */
+  padding: 8px;
+
+  /* radius.sheet */
+  border-radius: 16px;
+
+  /* Ardia's panel reads almost solid behind the list. The shared glass fill is
+   * tuned for surfaces that can blur the page through the window; a chrome
+   * popup is its own window, so none of that backdrop is available and the
+   * regular 86% tint lets page content show through crisply. Densify it for
+   * this surface only (the swipe capsule and PiP keep the shared recipe). */
+  --zen-ardia-glass-fill: light-dark(
+    rgba(248, 248, 252, 0.97),
+    rgba(40, 41, 45, 0.97)
+  );
+
+  /* React Native defaults to the platform UI font; mirror it in chrome. */
+  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui,
+    sans-serif;
+  -moz-osx-font-smoothing: grayscale;
+
+  user-select: none;
+  animation: ctrlTab-card-in 150ms cubic-bezier(0.2, 0, 0, 1);
+}
+
+/* Ardia <Panel fill={theme.panel} border={panelBorder} shadow={tabSwitcher}>
+ * tabSwitcher = dialog shadow with radius 28 and a 12px drop. */
+#ctrlTab-panel .ctrlTab-card.zen-ardia-glass {
+  background-color: var(--zen-ardia-glass-fill, light-dark(#ffffff, #2a2a2a));
+  backdrop-filter: var(
+    --zen-ardia-glass-filter,
+    blur(42px) saturate(180%)
+  ) !important;
+  -webkit-backdrop-filter: var(
+    --zen-ardia-glass-filter,
+    blur(42px) saturate(180%)
+  ) !important;
+
+  /* hairline.panel (0.5px) */
+  border: 0.5px solid
+    light-dark(rgba(0, 0, 0, 0.1), rgba(255, 255, 255, 0.1));
+  box-shadow: 0 12px 28px
+    light-dark(rgba(0, 0, 0, 0.18), rgba(0, 0, 0, 0.5));
+}
+
+@keyframes ctrlTab-card-in {
+  from {
+    opacity: 0;
+    transform: scale(0.96) translateY(-4px);
   }
+  to {
+    opacity: 1;
+    transform: scale(1) translateY(0);
+  }
 }
 
