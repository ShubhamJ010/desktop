+ * ---------------------------------------------------------------------- */
+.ctrlTab-preview {
   appearance: none;
-  color: inherit;
-  /* remove the :-moz-focusring outline from button.css on Windows */
-  outline: none !important;
   margin: 0;
-  text-shadow:
-    0 0 1px hsl(0, 0%, 12%),
