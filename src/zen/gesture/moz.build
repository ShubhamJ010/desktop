EXPORTS.mozilla += [
    "ZenSwipeCapsuleView.h",
    "ZenSwipeController.h",
    "ZenSwipeInternal.h",
    "ZenSwipeMath.h",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    SOURCES += [
        "ZenSwipeCapsuleView.mm",
        "ZenSwipeController.mm",
    ]

LOCAL_INCLUDES += [
    "/widget",
    "/widget/cocoa",
]

FINAL_LIBRARY = "xul"
