EXPORTS.mozilla += [
    "ZenPictureInPictureInternal.h",
    "ZenPiPThrowMath.h",
    "ZenPiPZoomMath.h",
]

if CONFIG["MOZ_WIDGET_TOOLKIT"] == "cocoa":
    SOURCES += [
        "ZenPiPControl.mm",
        "ZenPiPController+Swipe.mm",
        "ZenPiPController.mm",
        "ZenPiPHandle.mm",
        "ZenPiPOverlay.mm",
        "ZenPiPZoom.mm",
    ]

LOCAL_INCLUDES += [
    "/widget",
    "/widget/cocoa",
]

FINAL_LIBRARY = "xul"
